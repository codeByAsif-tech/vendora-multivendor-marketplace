# Only public values belong here: everything prefixed with VITE_ is bundled into the browser code.
# Never put secrets in the frontend.

# Leave empty in development (Vite proxies /api to http://localhost:5000).
# In production set the full API URL, e.g. https://your-api.onrender.com/api/v1
VITE_API_URL=

VITE_APP_NAME=Vendora

# UPI ID shown at checkout for "UPI / Bank transfer" payments (public value, not a secret).
VITE_PAYMENT_UPI_ID=yourname@upi
