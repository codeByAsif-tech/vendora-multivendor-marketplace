# Copy this file to .env and fill in real values. Never commit .env.

# ---- Server ----
NODE_ENV=development
PORT=5000
APP_NAME=Vendora
# Comma-separated list of allowed frontend origins (CORS). The first one is used in email links.
CLIENT_URL=http://localhost:5173

# ---- Database ----
# MongoDB Atlas connection string, e.g. mongodb+srv://<user>:<password>@<cluster>/<dbName>?retryWrites=true&w=majority
MONGODB_URI=

# ---- Auth ----
# Long random string (min 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
REFRESH_REUSE_GRACE_SECONDS=10
BCRYPT_SALT_ROUNDS=12

# Refresh cookie settings.
# Local dev (Vite proxy, same origin): lax / false
# Production with frontend and API on different domains: none / true
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# ---- Data encryption ----
# Encrypts seller bank account numbers at rest. Exactly 64 hex characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Do not change it after real data exists, or encrypted values can no longer be read.
DATA_ENCRYPTION_KEY=

# ---- Email (SMTP) ----
# Leave SMTP_HOST empty in development: emails are then only logged to the console.
# Free options: Mailtrap sandbox (testing), Resend SMTP (smtp.resend.com, user "resend", pass = API key), Brevo.
MAIL_FROM=asifali.shine77@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=asifali.shine77@gmail.com
SMTP_PASS=zjkm oemm hhbv yntg
SMTP_SECURE=false

# ---- File uploads ----
# local      = files saved to UPLOAD_DIR and served at /uploads (development only)
# cloudinary = Cloudinary free tier (needs the three CLOUDINARY_* values)
UPLOAD_DRIVER=local
UPLOAD_DIR=uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Seller earnings ----
# Platform commission in percent (admins can change it later in the admin panel)
DEFAULT_COMMISSION_RATE=10
# Days after delivery before a seller's earning can be paid out
EARNINGS_HOLD_DAYS=7

# ---- Accounts ----
# true = customers must verify their email before ordering, sellers before submitting their store
REQUIRE_VERIFIED_EMAIL=false

# ---- Deployment ----
# Reverse proxies in front of the API (Nginx / Render / Railway = 1, none = 0)
TRUST_PROXY=1

# ---- First admin (used only by: npm run seed:admin) ----
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
